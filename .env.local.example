# Copy this file to .env.local and fill in your own Supabase project's
# values (Project Settings → API in the Supabase dashboard, or
# `supabase projects api-keys --project-ref <ref>` via the CLI).
#
# Both of these are safe to expose to the browser (hence NEXT_PUBLIC_) —
# the anon/publishable key is designed to be public; Row Level Security in
# Postgres is what actually enforces who can read or write what. Never put
# the service_role/secret key in a NEXT_PUBLIC_ variable — it bypasses RLS
# entirely and must only ever be used in server-only code, if at all.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Phase 9 (Billing). service_role bypasses RLS entirely — Project Settings
# → API in the Supabase dashboard. Only ever read from server-only code
# (lib/supabase/admin.ts); never prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode to start). Secret key: Developers → API keys. Price id:
# the recurring Price you created for the Pro plan (Product catalog →
# your product → copy the Price's id, not the Product's). Webhook secret:
# printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# locally, or shown once when you add a webhook endpoint in the dashboard
# for production. The Checkout flow here redirects the browser to Stripe's
# own hosted page — no Stripe.js in our frontend — so no publishable key
# is required.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
