# Copy this file to .env.local and fill in your own Supabase project's
# values (Project Settings → API in the Supabase dashboard, or
# `supabase projects api-keys --project-ref <ref>` via the CLI).
#
# Both of these are safe to expose to the browser (hence NEXT_PUBLIC_) —
# the anon/publishable key is designed to be public; Row Level Security in
# Postgres is what actually enforces who can read or write what. Never put
# the service_role/secret key in a NEXT_PUBLIC_ variable — it bypasses RLS
# entirely and must only ever be used in server-only code, if at all.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
